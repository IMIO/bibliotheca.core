<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      metal:use-macro="context/main_template/macros/master"
      i18n:domain="collective.faceted.map">

<body>
<metal:content-core fill-slot="content-core">
  <metal:block define-macro="content-core">
    <div tal:define="
        folderContents folderContents | python:context.getFolderContents();
        Batch python:modules['Products.CMFPlone'].Batch;
        b_start python:request.get('b_start', 0);
        batch python:isinstance(folderContents, Batch) and folderContents or Batch(folderContents, 100, int(b_start), orphan=2);
        self nocall:context/@@faceted-map;
        map_view context/@@faceted-map-geojson;">

      <div metal:use-macro="context/batch_macros/macros/navigation"/>

      <div class="eea-preview-items">

        <div id="faceted-results-items" class="" data-geojson=""
             data-pat-leaflet="${self/map_configuration}"
             tal:define="thumb_scale view/get_thumb_scale_list;
                         images_orientation context/orientation | nothing;
                         orientation_class python:images_orientation and f'display-{images_orientation}' or ''"
             tal:attributes="data-geojson python:map_view.data_geo(batch);
                             class string:no-map ${orientation_class}">
        <tal:entries repeat="brain batch">
          <tal:entry tal:define="obj brain/getObject|nothing"
                     tal:condition="python:obj is not None">


            <div class=""
                 tal:define="portal_type brain/portal_type|string:;
                   useViewTypes brain/portal_properties/site_properties/typesUseViewActionInListings|python:[];
                   useView python:portal_type in useViewTypes;"
                 tal:attributes="data-index python:self.get_index(brain);
                                 class python:self.css_class(brain)">
              <a tal:define="description brain/Description|string:;
                             title brain/pretty_title_or_id|string:;
                             url brain/getURL|string:#"
                 tal:attributes="href url;
                                 title title">

                <div class="items-content">
                  <div class="geo-item-image">
                     <img style="border: none"
                          tal:attributes="src python:self.get_images(obj)"/>
                  </div>
                  <div class="geo-item-text">
                    <div class="geo-item-title" tal:content="brain/pretty_title_or_id|string:">Title</div>
                    <div class="geo-item-description" tal:content="description"></div>
                  </div>
                </div>
              </a>
            </div>

          </tal:entry>
        </tal:entries>
        <span tal:condition="not: batch/sequence_length"
              class="table_faceted_no_results"
              i18n:domain="plone"
              i18n:translate="description_no_results_found">No results were found.</span>
        </div>
      </div>
      <script type="text/javascript">
        // The GeoJSON is rendered on #faceted-results-items, but the visible
        // map is #faceted-map-container (from collective.faceted.map's
        // viewlet), whose data-geojson is hardcoded empty.
        //
        // pat-leaflet 2.x implements no 'leaflet.refresh'/'leaflet.openPopup'
        // events and reads data-geojson only once, at init, from its own
        // element - so jQuery .trigger() on those names is a no-op and no
        // marker is ever drawn. Drive the pattern through its own API instead:
        // Patternslib stores the instance on the element as
        // el["pattern-leaflet"] and fires a bubbling 'init.leaflet.patterns'
        // when init() resolves.
        (function () {
          var MAP_SELECTOR = "#faceted-map-container";
          var DATA_SELECTOR = "#faceted-results-items";

          function map_element() {
            return document.querySelector(MAP_SELECTOR);
          }

          function leaflet_pattern() {
            var el = map_element();
            return el ? el["pattern-leaflet"] : null;
          }

          function read_geojson() {
            var source = document.querySelector(DATA_SELECTOR);
            var raw = source && source.getAttribute("data-geojson");
            if (!raw) {
              return null;
            }
            try {
              return JSON.parse(raw);
            } catch (e) {
              return null;
            }
          }

          // init_geojson() adds the whole GeoJSON layer as one child of
          // marker_cluster, so flatten one level to reach the markers.
          function markers_of(pattern) {
            var markers = [];
            if (!pattern || !pattern.marker_cluster) {
              return markers;
            }
            pattern.marker_cluster.eachLayer(function (layer) {
              if (typeof layer.getLatLng === "function") {
                markers.push(layer);
              } else if (typeof layer.eachLayer === "function") {
                layer.eachLayer(function (marker) {
                  markers.push(marker);
                });
              }
            });
            return markers;
          }

          // Clearing first makes this idempotent, so calling it twice (once
          // eagerly, once on the init event) cannot duplicate markers.
          function draw_markers() {
            var pattern = leaflet_pattern();
            if (!pattern || !pattern.map || !pattern.marker_cluster) {
              return false;
            }
            pattern.marker_cluster.clearLayers();
            pattern.main_marker = null;
            var data = read_geojson();
            if (data && data.features && data.features.length) {
              pattern.init_geojson(pattern.map, data);
            }
            // The container gets moved around in the DOM below; Leaflet needs
            // to be told its size changed or tiles/bounds go stale.
            pattern.map.invalidateSize();
            return true;
          }

          // Registered before the pattern initialises: this inline script is
          // parsed with the document, while pat-leaflet instantiates from a
          // deferred bundle on DOMContentLoaded.
          document.addEventListener("init.leaflet.patterns", function (event) {
            if (event.target && event.target.id === "faceted-map-container") {
              draw_markers();
            }
          });

          jQuery(document).ready(function ($) {
            $(Faceted.Events).bind(Faceted.Events.AJAX_QUERY_START, function () {
              $(MAP_SELECTOR).appendTo($("#viewlet-below-content-body"));
            });

            $(Faceted.Events).bind(Faceted.Events.AJAX_QUERY_SUCCESS, function () {
              $(MAP_SELECTOR).prependTo($(".eea-preview-items"));
              draw_markers();
            });

            $(MAP_SELECTOR).prependTo($(".eea-preview-items"));
            $(".button-map-content").prependTo($(".eea-preview-items"));
            draw_markers();

            // Delegated, so the handlers survive the AJAX result replacement
            // that the previous direct .hover() binding did not.
            $(document).on("mouseenter", ".faceted-map-item", function () {
              var marker = markers_of(leaflet_pattern())[
                parseInt($(this).data("index"), 10)
              ];
              if (marker) {
                marker.openPopup();
              }
            });
            $(document).on("mouseleave", ".faceted-map-item", function () {
              var marker = markers_of(leaflet_pattern())[
                parseInt($(this).data("index"), 10)
              ];
              if (marker) {
                marker.closePopup();
              }
            });
          });
        })();
      </script>

      <div metal:use-macro="context/batch_macros/macros/navigation"/>

    </div>

  </metal:block>
</metal:content-core>
</body>
</html>

